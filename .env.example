# ==============================================================
# SASTA BAZAAR - Environment Variables (.env)
# ==============================================================
# Note: In Vite, all client-side variables must start with "VITE_"

# --- 1. STORE & BRAND CONFIG ---
VITE_STORE_NAME="SASTA BAZAAR"
VITE_STORE_TAGLINE="Everyday Luxury"
VITE_CURRENCY_SYMBOL="£"
VITE_CURRENCY_CODE="GBP"
VITE_FREE_SHIPPING_THRESHOLD=40.00
VITE_SUPPORT_EMAIL="support@sastabazaarclothing.com"
VITE_WHATSAPP_NUMBER="+447000000000"
VITE_INSTAGRAM_HANDLE="@sastabazaarclothing"

# --- 2. LIVE SHOPIFY STOREFRONT API (Optional - for direct sync) ---
# If you want live dynamic products directly from Shopify instead of local products.json:
VITE_SHOPIFY_STORE_DOMAIN="sastabazaarclothing.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN=""
VITE_SHOPIFY_API_VERSION="2024-01"

# --- 3. PAYMENT GATEWAYS (For Real Checkout) ---
# Stripe UK Publishable Key (for card payments)
VITE_STRIPE_PUBLISHABLE_KEY=""
# PayPal Client ID
VITE_PAYPAL_CLIENT_ID=""
# Klarna / Clearpay Merchant ID
VITE_KLARNA_CLIENT_ID=""

# --- 4. NEWSLETTER & CONTACT FORM INTEGRATION ---
# EmailJS / Formspree / Klaviyo for contact messages & newsletter emails
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
VITE_KLAVIYO_PUBLIC_KEY=""

# --- 5. ANALYTICS & ADS TRACKING (Optional) ---
# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=""
# Meta (Facebook/Instagram) Pixel ID
VITE_META_PIXEL_ID=""
VITE_TIKTOK_PIXEL_ID=""
