# ==============================================================
# SASTA BAZAAR - Full-Stack Custom Environment Config (.env)
# 100% Self-Hosted & Custom (No Shopify Required)
# ==============================================================

# --- 1. BACKEND SERVER CONFIG (Node.js / Express) ---
PORT=5000
NODE_ENV=development
ADMIN_PASSWORD=admin123

# --- 2. FRONTEND CLIENT CONFIG (Vite requires "VITE_" prefix) ---
VITE_API_URL="http://localhost:5000/api"

# --- 3. STORE & BRAND SETTINGS ---
VITE_STORE_NAME="SASTA BAZAAR"
VITE_STORE_TAGLINE="Everyday Luxury"
VITE_CURRENCY_SYMBOL="£"
VITE_CURRENCY_CODE="GBP"

# Free shipping order threshold in GBP
VITE_FREE_SHIPPING_THRESHOLD=40.00

# Support & Contact Information
VITE_SUPPORT_EMAIL="support@sastabazaarclothing.com"
VITE_WHATSAPP_NUMBER="+447000000000"
VITE_INSTAGRAM_HANDLE="@sastabazaarclothing"

# --- 4. PAYMENT GATEWAYS (Optional - Add when enabling live payments) ---
# Stripe for Card, Apple Pay & Google Pay
STRIPE_SECRET_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# PayPal
PAYPAL_CLIENT_ID=""
VITE_PAYPAL_CLIENT_ID=""

# --- 5. MARKETING & ANALYTICS (Optional) ---
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""
